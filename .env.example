# ── Meshtastic-es-map config ──────────────────────────────────────────────────
# Copia este fichero como .env y ajusta los valores

# URL de la instancia de meshview desde la que se recogen los datos
# (también la usa update-top.py, script local de desarrollo;
# si no se exporta, update-top.py usa http://localhost:18085 por defecto)
MESHVIEW_URL=https://meshview.meshtastic.es

# Puerto público del servidor web
WEB_PORT=8095

# Intervalo del collector en minutos
COLLECTOR_INTERVAL=5

# Días que se conservan los nodos en la base de datos (también controla la ventana del mapa)
NODE_RETENTION_DAYS=7

# Ruta de la base de datos dentro de los contenedores
DB_PATH=/data/meshtastic-es-map.db

# Directorio donde el collector escribe los JSON para el frontend
# En Docker: /data/json (montado en nginx como /map/data/)
# En VPS sin Docker: /ruta/al/repo/web/data
JSON_OUT=/data/json

# Posición inicial del mapa
# MAP_AUTO_FIT=true  → ajusta la vista para mostrar todos los nodos al cargar
# MAP_AUTO_FIT=false → usa las coordenadas y zoom definidos abajo
MAP_AUTO_FIT=true
MAP_LAT=40.2
MAP_LNG=-3.7
MAP_ZOOM=8

# URL del JSON con los nodos no optimizados (generado por update-top.py).
# Por defecto es interno: /data/top-nodos.json, servido por el mismo nginx
# que sirve el resto de JSON del mapa (no requiere infraestructura externa).
MAL_CONFIG_URL=/data/top-nodos.json

# Minutos entre recargas de update-top.py (análisis de nodos mal configurados).
# El script hace varias peticiones a la API de meshview por nodo, así que un
# intervalo corto puede generar bastante carga si hay muchos nodos activos.
TOP_NODOS_INTERVAL=60

# ── Personalización de la web (todas opcionales) ──────────────────────────────
# Si no se definen, la web usa sus valores por defecto y la traducción activa.

# Idioma por defecto con el que aparece la web (si el visitante no eligió otro).
# Valores disponibles: es (español) | gl (galego)
#DEFAULT_LANG=es

# Título del documento (pestaña del navegador)
#SITE_TITLE=Red Meshtastic España

# Marca de la cabecera. Se muestra como: «BRAND_PRIMARY / BRAND_SECONDARY»
# (BRAND_SECONDARY va en cursiva tras la barra)
#BRAND_PRIMARY=MESHTASTIC ESPAÑA
#BRAND_SECONDARY=Mapa de nodos

# Enlace del pie «Datos extraídos de:» — URL de destino y texto visible
#SOURCE_URL=https://meshview.meshtastic.es
#SOURCE_NAME=meshview.meshtastic.es
