# ── Meshtastic-es-map config ──────────────────────────────────────────────────
# Copia este fichero como .env y ajusta los valores

# URL de la instancia de meshview desde la que se recogen los datos
# (también la usa update-top.py, script local de desarrollo;
# si no se exporta, update-top.py usa http://localhost:18085 por defecto)
MESHVIEW_URL=https://meshview.meshtastic.es

# Puerto público del servidor web
WEB_PORT=8095

# Intervalo del collector en minutos
COLLECTOR_INTERVAL=5

# Días que se conservan los nodos en la base de datos (también controla la ventana del mapa)
NODE_RETENTION_DAYS=7

# Ruta de la base de datos dentro de los contenedores
DB_PATH=/data/meshtastic-es-map.db

# Directorio donde el collector escribe los JSON para el frontend
# En Docker: /data/json (montado en nginx como /map/data/)
# En VPS sin Docker: /ruta/al/repo/web/data
JSON_OUT=/data/json

# Posición inicial del mapa
# MAP_AUTO_FIT=true  → ajusta la vista para mostrar todos los nodos al cargar
# MAP_AUTO_FIT=false → usa las coordenadas y zoom definidos abajo
MAP_AUTO_FIT=true
MAP_LAT=40.2
MAP_LNG=-3.7
MAP_ZOOM=8

# URL del JSON con los nodos no optimizados (generado por update-top.py).
# Por defecto es interno: /data/top-nodos.json, servido por el mismo nginx
# que sirve el resto de JSON del mapa (no requiere infraestructura externa).
MAL_CONFIG_URL=/data/top-nodos.json

# Minutos entre recargas de update-top.py (análisis de nodos mal configurados).
# Cada ciclo sincroniza de forma incremental (solo lo nuevo desde el último
# ciclo) una BD SQLite propia con ventana rodante de 24h, así que un intervalo
# corto no vuelve a pedir 24h enteras cada vez — solo el delta.
TOP_NODOS_INTERVAL=15

# Ruta de la BD SQLite cíclica de paquetes de update-top.py (independiente de
# la BD del collector y de la de livefeed). Por defecto: data/topnodos.db
#TOPNODOS_DB_PATH=/data/topnodos.db

# ── Feed en vivo (MQTT) ────────────────────────────────────────────────────
# Servicio "livefeed": se suscribe al broker MQTT de Meshtastic y difunde por
# WebSocket los paquetes vistos por la malla (web/live.html). Deja
# MQTT_BROKER_HOST vacío para desactivarlo (el servicio arranca y sale sin error).
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=

# client_id con el que se conecta al broker. Algunos brokers de Meshtastic
# restringen por ACL qué client_id puede usar cada usuario (p.ej. debe
# coincidir con el propio usuario) — si no se indica, se usa MQTT_USERNAME.
MQTT_CLIENT_ID=

# Topics a los que suscribirse, separados por comas (se admiten varios).
# Los topics /map/ (MapReport) no llevan hop_limit/hop_start — el decoder
# los ignora automáticamente si no encajan como paquete de enrutamiento.
MQTT_TOPICS=msh/EU_868/2/e/MediumFast/+,msh/EU_868/2/e/LongFast/+,msh/EU_868/2/e/SFNarrow/+,msh/EU_868/2/e/Custom/+,msh/EU_868/2/map/+,msh/EU_868/2/e/PKI/+,msh/LORA_24/2/e/Medium24/+,msh/LORA_24/2/map/+,msh/LORA_24/2/e/PKI/+

# Puerto interno del servidor WebSocket del feed en vivo (nginx hace de proxy)
LIVE_WS_PORT=8765

# Segundos que se mantiene un packet_id en memoria para correlar sus distintas
# etapas (hop_limit) entre gateways antes de darlo por expirado
LIVE_CORRELATION_WINDOW_S=45

# Ruta de la base de datos SQLite donde se guardan los paquetes vistos —
# permite que un enlace compartido a un paquete concreto (?packet=<id>)
# siga funcionando pasada la ventana de correlación en memoria de arriba.
LIVEFEED_DB_PATH=/data/livefeed.db

# Días que se conservan los paquetes en esa base de datos antes de purgarse
LIVEFEED_RETENTION_DAYS=7

# ── Personalización de la web (todas opcionales) ──────────────────────────────
# Si no se definen, la web usa sus valores por defecto y la traducción activa.

# Idioma por defecto con el que aparece la web (si el visitante no eligió otro).
# Valores disponibles: es (español) | gl (galego) | en (English)
#DEFAULT_LANG=es

# Título del documento (pestaña del navegador)
#SITE_TITLE=Red Meshtastic España

# Marca de la cabecera. Se muestra como: «BRAND_PRIMARY / BRAND_SECONDARY»
# (BRAND_SECONDARY va en cursiva tras la barra)
#BRAND_PRIMARY=MESHTASTIC ESPAÑA
#BRAND_SECONDARY=Mapa de nodos

# Enlace del pie «Datos extraídos de:» — URL de destino y texto visible
#SOURCE_URL=https://meshview.meshtastic.es
#SOURCE_NAME=meshview.meshtastic.es

# Key gratuita de CARTO para las teselas del mapa base (carto.com/basemaps/apikey,
# sin cuenta, la envían al correo al momento). Recomendada: sin ella, CARTO sirve
# los tiles con un watermark "API KEY REQUIRED" superpuesto en todo el mapa.
#CARTO_API_KEY=
